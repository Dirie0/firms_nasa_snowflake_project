# ---- Secrets (never commit) ----
.env
.env.*
!.env.example
*.p8
*.pem
*.key

# ---- Terraform ----
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log
crash.*.log
# keep .terraform.lock.hcl committed (pins provider versions)

# ---- Airflow ----
airflow/logs/
airflow/config/airflow.cfg    # auto-generated by airflow-init

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
# keep poetry.lock committed

# ---- Local data and archives ----
python_scripts/data/
*.zip

# ---- OS / editor ----
.DS_Store
.idea/
.vscode/